<Window x:Class="MarketClock.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer"
        Width="380"
        SizeToContent="Height"
        Background="#101010"
        Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <FontFamily x:Key="JetBrainsMonoRegular">pack://application:,,,/fonts/#JetBrains Mono Regular</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#B8FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- An account in a dropdown: its name, then its balance. -->
        <DataTemplate x:Key="AccountItem">
            <TextBlock Foreground="Black">
                <Run Text="{Binding Name, Mode=OneWay}"/>
                <Run Text="{Binding Balance, Mode=OneWay, StringFormat='  ({0:N2})'}" Foreground="#666666"/>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="Transfer" FontSize="20"/>

        <TextBlock Text="From account" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="FromComboBox"
                  ItemTemplate="{StaticResource AccountItem}"
                  FontFamily="{StaticResource JetBrainsMonoRegular}"
                  Padding="8,6"/>

        <TextBlock Text="To account" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ToComboBox"
                  ItemTemplate="{StaticResource AccountItem}"
                  FontFamily="{StaticResource JetBrainsMonoRegular}"
                  Padding="8,6"/>

        <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
        <DatePicker x:Name="TransferDatePicker"
                    FontFamily="{StaticResource JetBrainsMonoRegular}"/>

        <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NoteTextBox"/>

        <TextBlock Text="Amount" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AmountTextBox"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Transfer" Click="Save_Click" IsDefault="True" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>

        <TextBlock x:Name="MessageTextBlock"
                   Text="Loading accounts..."
                   Foreground="{DynamicResource AccentBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
    </StackPanel>
</Window>
