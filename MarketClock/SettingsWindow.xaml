<Window x:Class="MarketClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarketClock"
        Title="Settings"
        Height="520"
        Width="860"
        MinHeight="360"
        MinWidth="640"
        Background="#101010"
        Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <FontFamily x:Key="JetBrainsMonoRegular">pack://application:,,,/fonts/#JetBrains Mono Regular</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#B8FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,7"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SettingsMessage"
                       Grid.Row="2"
                       Text="Loading..."
                       Foreground="Fuchsia"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,5,0"/>

            <TextBlock Grid.Row="0" Text="Settings" FontSize="20" Margin="0,0,0,8"/>

            <TreeView x:Name="SettingsTree"
                      Grid.Row="1"
                      Background="#141414"
                      BorderBrush="#33FFFFFF"
                      Margin="0,0,5,0"
                      Padding="4">
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#55FF00FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#33FFFFFF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                </TreeView.Resources>

                <TreeViewItem Header="Accounts" Tag="Accounts">
                    <TreeViewItem x:Name="AccountCategoriesItem" Header="Account Categories" Tag="AccountCategories"/>
                    <TreeViewItem Header="Expense Categories" Tag="ExpenseCategories"/>
                </TreeViewItem>
                <TreeViewItem Header="Media" Tag="Media">
                    <TreeViewItem Header="Songs" Tag="Songs"/>
                </TreeViewItem>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#33FFFFFF"
                      ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Margin="18,0,0,0">
            <StackPanel x:Name="AccountsPage" Visibility="Collapsed">
                <TextBlock Text="Accounts" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Settings for accounts. Pick a section from the tree on the left."
                           Style="{StaticResource PageHint}"/>
                <TextBlock Text="- Account Categories" Margin="0,0,0,6"/>
                <TextBlock Text="- Expense Categories"/>
            </StackPanel>

            <StackPanel x:Name="MediaPage" Visibility="Collapsed">
                <TextBlock Text="Media" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Settings for media. Pick a section from the tree on the left."
                           Style="{StaticResource PageHint}"/>
                <TextBlock Text="- Songs"/>
            </StackPanel>

            <StackPanel x:Name="SongsPage" Visibility="Collapsed">
                <TextBlock Text="Songs" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="The folder the Songs panel on the dashboard browses."
                           Style="{StaticResource PageHint}"/>
                <TextBlock Text="Songs folder" Foreground="#B8FFFFFF" FontSize="12" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SongsFolderTextBox"/>
                    <Button Grid.Column="1" Content="Browse..." Click="BrowseSongsFolder_Click" Margin="8,0,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save" Click="SaveSongsFolder_Click"/>
                </StackPanel>
                <TextBlock x:Name="SongsFolderMessage"
                           Foreground="Fuchsia"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <Grid x:Name="AccountCategoriesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Account Categories" Style="{StaticResource PageTitle}"/>
                <TextBlock Grid.Row="1"
                           Text="Categories you can assign to an account. Renaming one updates every account that uses it."
                           Style="{StaticResource PageHint}"/>
                <local:CategoryEditor x:Name="AccountCategoriesEditor" Grid.Row="2"/>
            </Grid>

            <Grid x:Name="ExpenseCategoriesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Expense Categories" Style="{StaticResource PageTitle}"/>
                <TextBlock Grid.Row="1"
                           Text="Categories for grouping expenses."
                           Style="{StaticResource PageHint}"/>
                <local:CategoryEditor x:Name="ExpenseCategoriesEditor" Grid.Row="2"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
