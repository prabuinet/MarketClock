<Window x:Class="MarketClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarketClock"
        xmlns:panels="clr-namespace:MarketClock.Panels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Background="Transparent" Opacity="0.95"        
        Foreground="White"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        Loaded="Window_Loaded"
        Title="Clock" Height="450" Width="800" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding ExitCommand}" />            
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Window.ContextMenu>
        <ContextMenu x:Name="DashboardMenu" Opened="DashboardMenu_Opened">
            <!-- One menu per column is put above this line each time the menu opens (MainWindow.Panels.cs). -->
            <Separator x:Name="ColumnMenusEnd" />
            <MenuItem x:Name="AccountsMenu" Header="Accounts" Click="AccountsMenu_Click" />
            <MenuItem x:Name="SettingsMenu" Header="Settings" Click="SettingsMenu_Click" />
            <MenuItem x:Name="ThemeMenu" Header="Theme" />
            <Separator />
            <MenuItem x:Name="MinimizeMenu" Header="Minimize" Click="MinimizeMenu_Click" />
            <MenuItem x:Name="MaximizeMenu" Header="Maximize" Click="MaximizeMenu_Click" />
            <MenuItem x:Name="RestoreMenu" Header="Restore" Click="RestoreMenu_Click" />
            <MenuItem x:Name="ExitMenu" Header="Exit" Command="{Binding ExitCommand}" Click="ExitMenu_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border BorderThickness="1" BorderBrush="#33FFFFFF" Background="Black">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="18"/>
                <Style.Triggers>
                    <!-- Square corners when the window fills the screen. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <!-- Edge resize grips -->
            <Rectangle x:Name="ResizeGripRight" HorizontalAlignment="Right" VerticalAlignment="Stretch" Panel.ZIndex="10" Width="4" Fill="Transparent" Cursor="SizeWE" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
            <Rectangle x:Name="ResizeGripBottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Panel.ZIndex="10" Height="4" Fill="Transparent" Cursor="SizeNS" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
            <Rectangle x:Name="ResizeGripLeft" HorizontalAlignment="Left" VerticalAlignment="Stretch" Panel.ZIndex="10" Width="4" Fill="Transparent" Cursor="SizeWE" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
            <Rectangle x:Name="ResizeGripTop" HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="10" Height="4" Fill="Transparent" Cursor="SizeNS" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>

            <!-- Corner resize grips -->
            <Rectangle x:Name="ResizeGripTopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="10" Width="8" Height="8" Fill="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
            <Rectangle x:Name="ResizeGripTopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Width="8" Height="8" Fill="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
            <Rectangle x:Name="ResizeGripBottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="10" Width="8" Height="8" Fill="Transparent" Cursor="SizeNESW" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>
            <Rectangle x:Name="ResizeGripBottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="10" Width="8" Height="8" Fill="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"/>

            <!-- The dashboard. MainWindow.Layout.cs builds the columns, rows and splitters in here
                 from the saved layout and places the panels declared below. -->
            <Grid x:Name="DashboardHost" Margin="14"/>

            <!-- Shows where a dragged panel will land. -->
            <Canvas x:Name="DashboardOverlay" Margin="14" IsHitTestVisible="False">
                <Rectangle x:Name="DropIndicator" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
            </Canvas>

            <!-- Every dashboard panel is declared here and moved into the dashboard at startup.
                 The content of each one is its own UserControl (see the Panels folder). -->
            <Grid x:Name="PanelParking" Visibility="Collapsed">
                <Border x:Name="ClockPanel" Style="{StaticResource PanelCard}">
                    <panels:ClockControl x:Name="ClockView"/>
                </Border>

                <!-- Counts down to the next full hour and rings a bell there (hours set in Settings > Hourly Bell). -->
                <Border x:Name="HourlyBellPanel" Style="{StaticResource PanelCard}">
                    <panels:HourlyBellControl x:Name="HourlyBellView"/>
                </Border>

                <Border x:Name="CountdownPanel" Style="{StaticResource PanelCard}">
                    <panels:CountdownControl x:Name="CountdownView"/>
                </Border>

                <Border x:Name="JeePanel" Style="{StaticResource PanelCard}">
                    <panels:JeeControl/>
                </Border>

                <Border x:Name="NetWorthPanel" Style="{StaticResource PanelCard}">
                    <panels:NetWorthControl x:Name="NetWorthView"/>
                </Border>

                <Border x:Name="NetWorthGraphPanel" Style="{StaticResource PanelCard}">
                    <panels:NetWorthGraphControl x:Name="NetWorthGraphView"/>
                </Border>

                <Border x:Name="AccountsPanel" Style="{StaticResource PanelCard}">
                    <panels:AccountsControl x:Name="AccountsView"/>
                </Border>

                <Border x:Name="BalancePanel" Style="{StaticResource PanelCard}">
                    <local:BalanceControl ExpenseRequested="AddExpense_Click" DailyMtmRequested="DailyMtm_Click" IncomeRequested="AddIncome_Click" TransferRequested="Transfer_Click"/>
                </Border>

                <Border x:Name="RecentPanel" Style="{StaticResource PanelCard}">
                    <panels:RecentTransactionsControl x:Name="RecentView"/>
                </Border>

                <Border x:Name="TopPanel" Style="{StaticResource PanelCard}">
                    <panels:TopTransactionsControl x:Name="TopView"/>
                </Border>

                <Border x:Name="DailyExpensesPanel" Style="{StaticResource PanelCard}">
                    <panels:DailyExpensesControl x:Name="DailyExpensesView"/>
                </Border>

                <Border x:Name="MonthSummaryPanel" Style="{StaticResource PanelCard}">
                    <panels:MonthSummaryControl x:Name="MonthSummaryView"/>
                </Border>

                <Border x:Name="SongsPanel" Style="{StaticResource PanelCard}">
                    <panels:SongsControl x:Name="SongsView"/>
                </Border>

                <Border x:Name="EqualizerPanel" Style="{StaticResource PanelCard}">
                    <panels:EqualizerControl x:Name="EqualizerView"/>
                </Border>

                <Border x:Name="TodoPanel" Style="{StaticResource PanelCard}">
                    <panels:TodoControl/>
                </Border>

                <Border x:Name="RemindersPanel" Style="{StaticResource PanelCard}">
                    <panels:RemindersControl/>
                </Border>

                <Border x:Name="NotesPanel" Style="{StaticResource PanelCard}">
                    <panels:NotesControl x:Name="NotesView"/>
                </Border>

                <Border x:Name="HabitsPanel" Style="{StaticResource PanelCard}">
                    <panels:HabitsControl/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
