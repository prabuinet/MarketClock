<UserControl x:Class="MarketClock.CategoryEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="CategoryListBox"
                 Grid.Row="0"
                 DisplayMemberPath="Name"
                 MinHeight="120"
                 MouseDoubleClick="CategoryListBox_MouseDoubleClick"/>

        <StackPanel x:Name="ListActionsPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="+ Add Category" Click="Add_Click" Margin="0,0,8,0"/>
            <Button Content="Edit" Click="Edit_Click"/>
        </StackPanel>

        <StackPanel x:Name="FormPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="FormTitle" Text="New Category" FontSize="14" Margin="0,0,0,6"/>
            <TextBlock Text="Name" Foreground="#B8FFFFFF" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="NameTextBox" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="+ Add" Click="Save_Click" IsDefault="True" Margin="0,0,8,0"/>
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageTextBlock"
                   Grid.Row="3"
                   Foreground="Fuchsia"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>
    </Grid>
</UserControl>
