<UserControl x:Class="MarketClock.Panels.EqualizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="320">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="Equalizer" Style="{StaticResource PanelHeader}"/>
            <TextBlock x:Name="EqualizerStyleText"
                       Style="{StaticResource PanelEmptyText}"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"/>
        </Grid>
        <!-- Click anywhere on the display to switch to the next look. -->
        <Grid Grid.Row="1"
              MinHeight="60"
              Background="Transparent"
              Cursor="Hand"
              ToolTip="Click to change the look"
              MouseLeftButtonDown="Equalizer_MouseLeftButtonDown">
            <!-- The shader paints over this rectangle. -->
            <Rectangle x:Name="EqualizerShaderSurface"
                       Fill="Black"
                       SizeChanged="EqualizerShaderSurface_SizeChanged"/>
            <!-- Plain bars, used only when shaders are unavailable. -->
            <Canvas x:Name="EqualizerCanvas"
                    ClipToBounds="True"
                    Visibility="Collapsed"
                    SizeChanged="EqualizerCanvas_SizeChanged"/>
            <TextBlock x:Name="EqualizerErrorText"
                       Style="{StaticResource PanelEmptyText}"
                       FontSize="10"
                       VerticalAlignment="Top"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
