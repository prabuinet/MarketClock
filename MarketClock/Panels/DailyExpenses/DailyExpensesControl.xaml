<UserControl x:Class="MarketClock.Panels.DailyExpensesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="240"
             d:DesignWidth="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title, table / chart switch and period filter; or, for one day, its date and Back -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText"
                       Text="Daily Expenses"
                       Style="{StaticResource PanelHeader}"
                       Margin="0,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <StackPanel x:Name="ModeButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TableModeButton" Style="{StaticResource PanelSmallButton}" ToolTip="Table" Click="TableMode_Click">
                    <!-- Takes the button's text colour, which marks the mode in use. -->
                    <iconPacks:PackIconMaterial Kind="TableLarge" Width="14" Height="14"/>
                </Button>
                <Button x:Name="ChartModeButton" Style="{StaticResource PanelSmallButton}" ToolTip="Chart" Click="ChartMode_Click">
                    <!-- Takes the button's text colour, which marks the mode in use. -->
                    <iconPacks:PackIconMaterial Kind="ChartBar" Width="14" Height="14"/>
                </Button>
            </StackPanel>
            <ComboBox x:Name="RangeComboBox"
                      Grid.Column="2"
                      Style="{StaticResource PanelComboBox}"
                      VerticalAlignment="Center"
                      SelectedIndex="1"
                      SelectionChanged="Range_SelectionChanged">
                <ComboBoxItem Content="Week" Tag="Week"/>
                <ComboBoxItem Content="Month" Tag="Month"/>
                <ComboBoxItem Content="Year" Tag="Year"/>
            </ComboBox>
            <Button x:Name="BackButton"
                    Grid.Column="2"
                    Content="&lt; Back"
                    Style="{StaticResource PanelSmallButton}"
                    Margin="0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="Back_Click"/>
        </Grid>

        <!-- Total for the period, or the bar under the mouse -->
        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Style="{StaticResource PanelEmptyText}"
                   FontSize="11"
                   Margin="0,6,0,8"/>

        <!-- Table: one line per day that has expenses, newest first. Click a line to open that day. -->
        <Grid x:Name="TableView" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="4,0,8,2">
                <TextBlock Text="Date" Style="{StaticResource PanelEmptyText}" FontSize="10"/>
                <TextBlock Text="Expense" Style="{StaticResource PanelEmptyText}" FontSize="10" HorizontalAlignment="Right"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ExpenseRowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PanelRowButton}"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip="Show this day's expenses"
                                    Click="ExpenseRow_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date}"
                                               Style="{StaticResource PanelText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Amount, StringFormat={}{0:N2}}"
                                               Style="{StaticResource PanelText}"
                                               Foreground="Fuchsia"
                                               Margin="10,0,4,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Chart: one bar per day (per month when the period is a year). Click a bar to open it. -->
        <Grid x:Name="ChartView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Value scale -->
            <TextBlock x:Name="ChartMaxLabel"
                       Style="{StaticResource PanelEmptyText}"
                       FontSize="10"
                       VerticalAlignment="Top"
                       Margin="0,0,8,0"/>
            <TextBlock Text="0"
                       Style="{StaticResource PanelEmptyText}"
                       FontSize="10"
                       VerticalAlignment="Bottom"
                       Margin="0,0,8,0"/>

            <!-- Bars -->
            <Grid Grid.Column="1" MinHeight="40">
                <Border BorderBrush="#18FFFFFF" BorderThickness="0,1,0,1"/>
                <Canvas x:Name="ChartCanvas"
                        Background="Transparent"
                        ClipToBounds="True"
                        Cursor="Hand"
                        MouseLeftButtonDown="ChartCanvas_MouseLeftButtonDown"
                        SizeChanged="ChartCanvas_SizeChanged"
                        MouseMove="ChartCanvas_MouseMove"
                        MouseLeave="ChartCanvas_MouseLeave"/>
            </Grid>

            <!-- Date scale -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                <TextBlock x:Name="ChartStartLabel"
                           Style="{StaticResource PanelEmptyText}"
                           FontSize="10"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="ChartEndLabel"
                           Style="{StaticResource PanelEmptyText}"
                           FontSize="10"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <!-- The expenses of the day (or month) that was clicked -->
        <ScrollViewer x:Name="DetailView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsControl x:Name="DetailList" ItemTemplate="{StaticResource DashboardTransactionTemplate}" Margin="0,0,4,0"/>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText"
                   Grid.Row="2"
                   Text="Loading..."
                   Style="{StaticResource PanelEmptyText}"/>
    </Grid>
</UserControl>
