<UserControl x:Class="MarketClock.Panels.HourlyBellControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="320">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>                            
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0">
            <TextBlock x:Name="HourlyBellCountdownText"
                       Text="00:00"
                       Padding="5"
                       Foreground="DeepPink"
                       FontFamily="{StaticResource JetBrainsMonoThin}"
                       FontSize="14"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Viewbox>
        <TextBlock x:Name="HourlyBellNextText"
                   Grid.Row="1"
                   Foreground="#ccc"
                   Style="{StaticResource PanelEmptyText}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>
    </Grid>
</UserControl>
