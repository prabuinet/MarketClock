<UserControl x:Class="MarketClock.Panels.RecentTransactionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="320">
    <StackPanel>
        <TextBlock Text="Recent Transactions" Style="{StaticResource PanelHeader}"/>
        <TextBlock x:Name="RecentEmptyText" Text="Loading..." Style="{StaticResource PanelEmptyText}"/>
        <!-- The transparent background makes the whole width of a row react to the mouse, not only its text. -->
        <ItemsControl x:Name="RecentTransactionsList"
                      ItemTemplate="{StaticResource DashboardTransactionTemplate}"
                      Background="Transparent"
                      ToolTip="Double-click to edit, right-click to edit or delete"
                      MouseLeftButtonDown="RecentTransactionsList_MouseLeftButtonDown"
                      ContextMenuOpening="RecentTransactionsList_ContextMenuOpening">
            <!-- Its own menu, so a right-click on a transaction does not open the window's menu. -->
            <ItemsControl.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit" Click="EditMenu_Click"/>
                    <MenuItem Header="Delete" Click="DeleteMenu_Click"/>
                </ContextMenu>
            </ItemsControl.ContextMenu>
        </ItemsControl>
    </StackPanel>
</UserControl>
