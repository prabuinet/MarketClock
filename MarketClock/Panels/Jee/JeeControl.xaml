<UserControl x:Class="MarketClock.Panels.JeeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="320">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Exam Days Left:"
                           Style="{StaticResource PanelText}"
                           Foreground="#CCFFFFFF"
                           FontSize="8"
                           Margin="4,0,2,0"/>
                    <TextBlock Text="{Binding JeeDays}"
                           Style="{StaticResource PanelText}"
                           Foreground="#eee"
                           FontSize="9"
                           Margin="0,0,4,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Hours Left:"
                           Style="{StaticResource PanelText}"
                           Foreground="#CCFFFFFF"
                           FontSize="8"
                           Margin="4,0,2,0"/>
                    <TextBlock Text="{Binding JeeHours}"
                           Style="{StaticResource PanelText}"
                           Foreground="#eee"
                           Margin="0,0,4,0"
                           FontSize="9"/>
                </StackPanel>
            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
