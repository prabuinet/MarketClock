<UserControl x:Class="MarketClock.Panels.NetWorthGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="320">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Title and range dropdown -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Net Worth Graph"
                       Style="{StaticResource PanelHeader}"
                       Margin="0"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="NetWorthRangeComboBox"
                      Grid.Column="1"
                      Style="{StaticResource PanelComboBox}"
                      SelectedIndex="1"
                      SelectionChanged="NetWorthRange_SelectionChanged">
                <ComboBoxItem Content="Last 15 days" Tag="15D"/>
                <ComboBoxItem Content="Last 30 days" Tag="30D"/>
                <ComboBoxItem Content="Last 3 months" Tag="3M"/>
                <ComboBoxItem Content="One year" Tag="1Y"/>
                <ComboBoxItem Content="Full" Tag="All"/>
            </ComboBox>
        </Grid>

        <!-- Range summary, or the day under the mouse -->
        <TextBlock x:Name="NetWorthGraphReadout"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource PanelEmptyText}"
                   FontSize="11"
                   Margin="0,6,0,8"/>

        <!-- Value scale -->
        <TextBlock x:Name="NetWorthMaxLabel"
                   Grid.Row="2"
                   Style="{StaticResource PanelEmptyText}"
                   FontSize="10"
                   VerticalAlignment="Top"
                   Margin="0,0,8,0"/>
        <TextBlock x:Name="NetWorthMinLabel"
                   Grid.Row="2"
                   Style="{StaticResource PanelEmptyText}"
                   FontSize="10"
                   VerticalAlignment="Bottom"
                   Margin="0,0,8,0"/>

        <!-- Plot -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Border BorderBrush="#18FFFFFF" BorderThickness="0,1,0,1"/>
            <Rectangle Height="1" Fill="#18FFFFFF" VerticalAlignment="Center"/>
            <Canvas x:Name="NetWorthChartCanvas"
                    Background="Transparent"
                    SizeChanged="NetWorthChart_SizeChanged"
                    MouseMove="NetWorthChart_MouseMove"
                    MouseLeave="NetWorthChart_MouseLeave">
                <Line x:Name="NetWorthHoverLine"
                      Stroke="#55FFFFFF"
                      StrokeThickness="1"
                      Visibility="Collapsed"/>
                <Polyline x:Name="NetWorthLine"
                          Stroke="LightCyan"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                <Ellipse x:Name="NetWorthHoverDot"
                         Width="8"
                         Height="8"
                         Fill="LightCyan"
                         Stroke="Black"
                         StrokeThickness="2"
                         Visibility="Collapsed"/>
            </Canvas>
        </Grid>

        <!-- Date scale -->
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
            <TextBlock x:Name="NetWorthStartLabel"
                       Style="{StaticResource PanelEmptyText}"
                       FontSize="10"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="NetWorthEndLabel"
                       Style="{StaticResource PanelEmptyText}"
                       FontSize="10"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
