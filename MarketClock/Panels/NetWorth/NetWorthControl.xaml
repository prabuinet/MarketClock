<UserControl x:Class="MarketClock.Panels.NetWorthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="320">
    <StackPanel>
        <TextBlock Text="Net Worth" Style="{StaticResource PanelHeader}"/>
        <TextBlock x:Name="NetWorthText"
                   Text="-"
                   Style="{StaticResource PanelText}"
                   FontSize="24"
                   Foreground="LightCyan"/>
        <TextBlock x:Name="NetWorthHint"
                   Text="Loading..."
                   Style="{StaticResource PanelEmptyText}"
                   FontSize="11"
                   Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
