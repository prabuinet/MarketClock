<UserControl x:Class="MarketClock.Panels.CountdownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="220"
             d:DesignWidth="320">
    <UserControl.Resources>
        <!-- The hours / minutes / seconds boxes of the custom time editor. -->
        <Style x:Key="TimePartBox" TargetType="TextBox">
            <Setter Property="Width" Value="38"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,3"/>
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TimePartLabel" TargetType="TextBlock" BasedOn="{StaticResource PanelEmptyText}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, and Stop while a countdown is running -->
        <Grid Grid.Row="0">
            <TextBlock Text="Countdown" Style="{StaticResource PanelHeader}" Margin="0" VerticalAlignment="Center"/>
            <Button x:Name="StopButton"
                    Style="{StaticResource PanelIconButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ToolTip="Stop the countdown"
                    Visibility="Hidden"
                    Click="Stop_Click">
                <iconPacks:PackIconMaterial Kind="Stop" Width="14" Height="14"/>
            </Button>
        </Grid>

        <!-- Time left (hidden until a countdown is started) -->
        <Viewbox x:Name="DisplayBox" Grid.Row="1" MinHeight="24" Visibility="Collapsed">
            <TextBlock x:Name="CountdownText"
                       Text=""
                       Padding="5"
                       Foreground="#66FFFFFF"
                       FontFamily="{StaticResource JetBrainsMonoThin}"
                       FontSize="14"
                       TextAlignment="Center"/>
        </Viewbox>

        <!-- When it ends; or what is wrong with a custom time -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Visibility="Collapsed"
                   Style="{StaticResource PanelEmptyText}"
                   FontSize="11"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,6"/>

        <!-- The time buttons and the custom time editor. They sit in the middle of the panel until a
             countdown is started, are hidden while it runs, and come back under the 00:00 when it
             ends (see ShowDisplay in the code). -->
        <StackPanel x:Name="ButtonsArea" Grid.Row="1" VerticalAlignment="Center">
            <!-- One button per time (filled in by the code), then the button that adds another -->
            <WrapPanel x:Name="PresetsPanel" HorizontalAlignment="Center">
                <Button x:Name="AddPresetButton"
                        Style="{StaticResource PanelIconButton}"
                        Margin="0,0,0,6"
                        ToolTip="Add a button for a custom time"
                        Click="AddPreset_Click">
                    <iconPacks:PackIconMaterial Kind="TimerPlusOutline" Width="15" Height="15"/>
                </Button>
            </WrapPanel>

            <!-- Custom time: hours, minutes, seconds -->
            <StackPanel x:Name="CustomEditor"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0"
                        Visibility="Collapsed">
                <TextBox x:Name="HoursBox" Style="{StaticResource TimePartBox}" KeyDown="CustomEditor_KeyDown"/>
                <TextBlock Text="h" Style="{StaticResource TimePartLabel}"/>
                <TextBox x:Name="MinutesBox" Style="{StaticResource TimePartBox}" KeyDown="CustomEditor_KeyDown"/>
                <TextBlock Text="m" Style="{StaticResource TimePartLabel}"/>
                <TextBox x:Name="SecondsBox" Style="{StaticResource TimePartBox}" KeyDown="CustomEditor_KeyDown"/>
                <TextBlock Text="s" Style="{StaticResource TimePartLabel}"/>
                <Button Style="{StaticResource PanelIconButton}" ToolTip="Add this button" Click="CustomAdd_Click">
                    <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="#39D353"/>
                </Button>
                <Button Style="{StaticResource PanelIconButton}" ToolTip="Cancel" Click="CustomCancel_Click">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
