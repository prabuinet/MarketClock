<UserControl x:Class="MarketClock.Panels.MonthSummaryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="160"
             d:DesignWidth="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title and text / chart switch -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="This Month"
                       Style="{StaticResource PanelHeader}"
                       Margin="0,0,8,0"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TextModeButton" Style="{StaticResource PanelSmallButton}" ToolTip="Figures" Click="TextMode_Click">
                    <!-- Takes the button's text colour, which marks the mode in use. -->
                    <iconPacks:PackIconMaterial Kind="Numeric" Width="14" Height="14"/>
                </Button>
                <Button x:Name="ChartModeButton" Style="{StaticResource PanelSmallButton}" Margin="0" ToolTip="Chart" Click="ChartMode_Click">
                    <!-- Takes the button's text colour, which marks the mode in use. -->
                    <iconPacks:PackIconMaterial Kind="AlignHorizontalLeft" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The month, and income less expense -->
        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Text="Loading..."
                   Style="{StaticResource PanelEmptyText}"
                   FontSize="11"
                   Margin="0,6,0,6"/>

        <!-- Text: expense on the left, income on the right. Both sit in one Viewbox,
             so they are always drawn at the same size however long each figure is. -->
        <Viewbox x:Name="TextView" Grid.Row="2" Margin="4,2" MaxHeight="90">
            <UniformGrid Columns="2">
                <StackPanel Margin="8,0">
                    <TextBlock Text="Expense"
                               Style="{StaticResource PanelEmptyText}"
                               FontSize="7"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExpenseText"
                               Text="-"
                               Style="{StaticResource PanelText}"
                               FontSize="14"
                               Foreground="Fuchsia"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <Border BorderBrush="#33FFFFFF" BorderThickness="0.5,0,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="Income"
                                   Style="{StaticResource PanelEmptyText}"
                                   FontSize="7"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="IncomeText"
                                   Text="-"
                                   Style="{StaticResource PanelText}"
                                   FontSize="14"
                                   Foreground="#39D353"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Viewbox>

        <!-- Chart: one horizontal bar each, drawn to the same scale -->
        <Grid x:Name="ChartView" Grid.Row="2" VerticalAlignment="Center" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Expense" Style="{StaticResource PanelText}" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
            <Grid Grid.Row="0" Grid.Column="1" Height="16" Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ExpenseBarColumn" Width="0*"/>
                    <ColumnDefinition x:Name="ExpenseRestColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="#10FFFFFF" CornerRadius="3"/>
                <Border Background="Fuchsia" CornerRadius="3"/>
            </Grid>
            <TextBlock x:Name="ExpenseBarText" Grid.Row="0" Grid.Column="2" Text="-" Style="{StaticResource PanelText}" Foreground="Fuchsia" HorizontalAlignment="Right" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Income" Style="{StaticResource PanelText}" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
            <Grid Grid.Row="1" Grid.Column="1" Height="16" Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IncomeBarColumn" Width="0*"/>
                    <ColumnDefinition x:Name="IncomeRestColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="#10FFFFFF" CornerRadius="3"/>
                <Border Background="#39D353" CornerRadius="3"/>
            </Grid>
            <TextBlock x:Name="IncomeBarText" Grid.Row="1" Grid.Column="2" Text="-" Style="{StaticResource PanelText}" Foreground="#39D353" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
