<UserControl x:Class="MarketClock.Panels.TopTransactionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="320">
    <StackPanel>
        <TextBlock Text="Top Transactions This Month" Style="{StaticResource PanelHeader}"/>
        <TextBlock x:Name="TopEmptyText" Text="Loading..." Style="{StaticResource PanelEmptyText}"/>
        <ItemsControl x:Name="TopTransactionsList" ItemTemplate="{StaticResource DashboardTransactionTemplate}"/>
    </StackPanel>
</UserControl>
