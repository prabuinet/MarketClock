<UserControl x:Class="MarketClock.BalanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="400">
    <UserControl.Resources>
        <FontFamily x:Key="JetBrainsMonoRegular">pack://application:,,,/fonts/#JetBrains Mono Regular</FontFamily>
        <Style x:Key="BalanceActionButton" TargetType="Button">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FF00FF"/>
                    <Setter Property="BorderBrush" Value="#AAFF00FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Actions" Style="{StaticResource PanelHeader}"/>
        <!-- Icon-only buttons; the tooltip says what each one does. -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource BalanceActionButton}" ToolTip="Add expense" Click="AddExpenseButton_Click">
                <iconPacks:PackIconMaterial Kind="CashMinus" Width="20" Height="20" Foreground="Fuchsia"/>
            </Button>
            <Button Style="{StaticResource BalanceActionButton}" ToolTip="Add income" Click="AddIncomeButton_Click">
                <iconPacks:PackIconMaterial Kind="CashPlus" Width="20" Height="20" Foreground="#39D353"/>
            </Button>
            <Button Style="{StaticResource BalanceActionButton}" ToolTip="Daily MTM" Click="DailyMtmButton_Click">
                <iconPacks:PackIconMaterial Kind="ChartLine" Width="20" Height="20" Foreground="Gold"/>
            </Button>
            <Button Style="{StaticResource BalanceActionButton}" ToolTip="Transfer between accounts" Click="TransferButton_Click">
                <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="20" Height="20" Foreground="LightCyan"/>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
