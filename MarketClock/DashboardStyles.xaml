<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fonts, styles and templates shared by the dashboard (MainWindow.xaml) and its panels
         (the Panels folder). Merged into the application resources in App.xaml. -->
    <FontFamily x:Key="Digital7Font">pack://application:,,,/fonts/#digital-7 (mono)</FontFamily>
    <FontFamily x:Key="JetBrainsMonoNLThin">pack://application:,,,/fonts/#JetBrainsMonoNL-Thin</FontFamily>
    <FontFamily x:Key="JetBrainsMonoThin">pack://application:,,,/fonts/#JetBrains Mono Thin</FontFamily>
    <FontFamily x:Key="JetBrainsMonoRegular">pack://application:,,,/fonts/#JetBrains Mono Regular</FontFamily>
    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="#12FFFFFF"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="PanelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="PanelEmptyText" TargetType="TextBlock" BasedOn="{StaticResource PanelText}">
        <Setter Property="Foreground" Value="#80FFFFFF"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Dark dropdown for use on the dashboard. -->
    <Style x:Key="PanelComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="#18FFFFFF"
                                            BorderBrush="#44FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          Margin="8,4,24,4"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path IsHitTestVisible="False"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M 0 0 L 4 4 L 8 0"
                              Stroke="#CCFFFFFF"
                              StrokeThickness="1.5"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="#1C1C1C"
                                    BorderBrush="#44FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A flat, full-width row that behaves like a button (used by the Songs panel). -->
    <Style x:Key="PanelRowButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowBorder" Background="Transparent" CornerRadius="4" Padding="4,4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#18FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="#33FF00FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PanelSmallButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="#10FFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#22FF00FF"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AAFF00FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A bare icon that lights up under the mouse. The icon inside takes the button's Foreground. -->
    <Style x:Key="PanelIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IconBorder" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IconBorder" Property="Background" Value="#33FF00FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The gaps between dashboard panels and columns: drag one to resize its neighbours. -->
    <Style x:Key="DashboardSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ShowsPreview" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Margin="2"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#55FF00FF"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="#AAFF00FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="DashboardTransactionTemplate">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Date}"
                       Style="{StaticResource PanelText}"
                       Foreground="#80FFFFFF"
                       Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1"
                       Style="{StaticResource PanelText}"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Title, Mode=OneWay}"/>
                <Run Text="{Binding Account, Mode=OneWay, StringFormat='· {0}'}" Foreground="#80FFFFFF"/>
            </TextBlock>
            <TextBlock Grid.Column="2"
                       Text="{Binding Amount, StringFormat={}{0:N2}}"
                       Margin="10,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource PanelText}">
                        <Setter Property="Foreground" Value="LightCyan"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDebit}" Value="True">
                                <Setter Property="Foreground" Value="Fuchsia"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
