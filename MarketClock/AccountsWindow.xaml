<Window x:Class="MarketClock.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Accounts"
        Height="520"
        Width="860"
        MinHeight="360"
        MinWidth="680"
        Background="#101010"
        Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <FontFamily x:Key="JetBrainsMonoRegular">pack://application:,,,/fonts/#JetBrains Mono Regular</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="DimGray"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#18FFFFFF"/>
            <Setter Property="RowBackground" Value="#101010"/>
            <Setter Property="AlternatingRowBackground" Value="#151515"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="360"/>            
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,2">
                <TextBlock Text="Accounts" FontSize="20" Margin="0,0,0,2"/>
            </StackPanel>

            <Grid x:Name="AccountListPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                         MinHeight="160" Margin="0,0,5,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding CategoryName}"
                                               Foreground="#80FFFFFF"
                                               FontSize="10"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Balance, StringFormat={}{0:N2}}"
                                           Foreground="LightCyan"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="+ Add Account" Click="AddAccount_Click" Margin="0,0,8,0"/>
                    <Button Content="Edit" Click="EditAccount_Click" Margin="0,0,8,0"/>
                    <Button Content="Delete" Click="DeleteAccount_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="CreateAccountPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="AccountFormTitle" Text="New Account" FontSize="14" Margin="0,0,0,2"/>
                <TextBlock x:Name="AccountFormHint" Text="Create an account with its opening balance." TextWrapping="Wrap" Margin="0,0,0,5" Foreground="#B8FFFFFF" FontSize="10"/>
                <TextBlock Text="Name" Foreground="#B8FFFFFF" FontSize="12"/>
                <TextBox x:Name="AccountNameTextBox" Margin="0,0,5,0"/>
                <TextBlock Text="Category" Foreground="#B8FFFFFF" FontSize="12" Margin="0,5,0,0"/>
                <ComboBox x:Name="CategoryComboBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          FontFamily="{StaticResource JetBrainsMonoRegular}"
                          Padding="8,6"
                          Margin="0,0,5,0"/>
                <TextBlock Text="Opening Balance" Foreground="#B8FFFFFF" FontSize="12" Margin="0,5,0,0" />
                <TextBox x:Name="OpeningBalanceTextBox" Text="" Margin="0,0,5,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveAccountButton" Content="+ Create" Click="CreateAccount_Click" IsDefault="True" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Click="CancelCreateAccount_Click" IsCancel="True"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="FormMessageTextBlock"
                       Grid.Row="2"
                       Foreground="Fuchsia"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </Grid>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#33FFFFFF"
                      ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Margin="18,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Transactions" FontSize="20" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SelectedAccount.Name, TargetNullValue=Select or create an account}"
                           Foreground="White"
                           FontSize="12"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding SelectedAccount.Transactions}"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}" Width="110"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding ExpenseCategory.Name}" Width="130"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border x:Name="LoadingOverlay"
                Grid.ColumnSpan="3"
                Background="#E6101010">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading accounts..."
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True"
                             Width="220"
                             Height="4"
                             Foreground="Fuchsia"
                             Background="#22FFFFFF"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
